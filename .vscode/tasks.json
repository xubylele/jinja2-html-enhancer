{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "install",
			"type": "shell",
			"command": "npm ci",
			"options": {
				"env": {
					"NODE_AUTH_TOKEN": "${env:NODE_AUTH_TOKEN}"
				}
			},
			"problemMatcher": [],
			"detail": "Install deps from GitHub Packages (requires NODE_AUTH_TOKEN in shell env)"
		},
		{
			"label": "build",
			"type": "shell",
			"command": "npm run build",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Compilación de la extensión con esbuild"
		},
		{
			"label": "watch",
			"type": "shell",
			"command": "npm run watch",
			"problemMatcher": [],
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"detail": "Compilación en modo watch con esbuild"
		}
	]
}