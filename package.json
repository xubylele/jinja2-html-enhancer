{
  "name": "jinja2-html-enhancer",
  "displayName": "Jinja2 HTML Enhancer",
  "description": "Syntax highlighting and variable checking for Jinja2 templates",
  "version": "1.0.0",
  "publisher": "Xubylele",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.checkJinja2Variables",
        "title": "Check Jinja2 Variables"
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".html"
        ],
        "aliases": [
          "HTML (Jinja2)"
        ]
      }
    ],
    "grammars": [
      {
        "language": "html",
        "scopeName": "text.html.jinja2",
        "path": "./syntaxes/jinja2.tmLanguage.json",
        "injectTo": [
          "text.html"
        ]
      }
    ]
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^14.x",
    "@types/mocha": "^9.0.0",
    "@types/glob": "^7.1.4",
    "typescript": "^4.4.3",
    "vscode-test": "^1.6.1",
    "mocha": "^9.1.1",
    "eslint": "^7.32.0",
    "@typescript-eslint/parser": "^4.31.1",
    "@typescript-eslint/eslint-plugin": "^4.31.1",
    "glob": "^7.1.7"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  }
}