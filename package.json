{
  "name": "jinja2-html-enhancer",
  "displayName": "Jinja2 HTML Enhancer",
  "description": "Syntax highlighting for Jinja2 templates with .jinja2.html extension",
  "version": "0.1.3",
  "publisher": "Xubylele",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xubylele/jinja2-html-enhancer.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:jinja2"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension.checkJinja2Variables",
        "title": "Check Jinja2 Variables"
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".jinja2.html",
          ".html"
        ],
        "aliases": [
          "HTML (Jinja2)",
          "HTML"
        ]
      }
    ],
    "grammars": [
      {
        "language": "html",
        "scopeName": "text.html.jinja2",
        "path": "./syntaxes/jinja2.tmLanguage.json",
        "injectTo": [
          "text.html"
        ]
      }
    ]
  },
  "dependencies": {
    "vscode": "^1.1.37"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^14.14.37",
    "@types/vscode": "^1.93.0",
    "typescript": "^4.2.4"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  }
}