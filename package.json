{
  "name": "jinja2-html-enhancer",
  "displayName": "Jinja2 Enhance",
  "description": "Syntax highlighting and variable checking for Jinja2 templates",
  "version": "1.10.0",
  "publisher": "Xubylele",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.102.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xubylele/jinja2-html-enhancer.git"
  },
  "bugs": {
    "url": "https://github.com/xubylele/jinja2-html-enhancer/issues"
  },
  "homepage": "https://github.com/xubylele/jinja2-html-enhancer#readme",
  "changelog": "https://github.com/xubylele/jinja2-html-enhancer/blob/main/CHANGELOG.md",
  "license": "MIT",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "%extension.configuration.title%",
      "properties": {
        "jinja2-html-enhancer.customVariables": {
          "type": "object",
          "description": "%extension.configuration.customVariables.description%",
          "default": {},
          "scope": "resource"
        },
        "jinja2-html-enhancer.toggleVariableCheck": {
          "type": "boolean",
          "description": "%extension.configuration.toggleVariableCheck.description%",
          "default": false,
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "command": "extension.checkJinja2Variables",
        "title": "%checkVariables.title%"
      },
      {
        "command": "extension.openVariablePanel",
        "title": "%openVariables.title%"
      },
      {
        "command": "extension.saveVariable",
        "title": "%saveVariable.title%"
      },
      {
        "command": "extension.toggleVariableCheck",
        "title": "%toggleVariableCheck.title%"
      },
      {
        "command": "extension.changeTheme",
        "title": "%changeTheme.title%"
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".html"
        ],
        "aliases": [
          "HTML (Jinja2)"
        ]
      }
    ],
    "grammars": [
      {
        "language": "html",
        "scopeName": "text.html.jinja2",
        "path": "./syntaxes/jinja2.tmLanguage.json",
        "injectTo": [
          "text.html"
        ]
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint-community/eslint-utils": "^4.7.0",
    "@eslint-community/regexpp": "^4.12.1",
    "@eslint/config-array": "^0.21.0",
    "@eslint/core": "^0.15.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/object-schema": "^2.1.6",
    "@eslint/plugin-kit": "^0.3.3",
    "@jest/globals": "^30.0.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@tybys/wasm-util": "^0.9.0",
    "@types/glob": "^9.0.0",
    "@types/i18n": "^0.13.12",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/vscode": "1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "babel-jest": "^30.0.4",
    "downlevel-dts": "^0.11.0",
    "esbuild": "^0.25.6",
    "eslint": "^9.31.0",
    "i18n": "^0.15.1",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "jest-specific-snapshot": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vscode-test": "^1.6.1"
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && npm run build:tailwind && node esbuild.js",
    "build": "npm run build:tailwind && node esbuild.js --production",
    "watch": "npm run build:tailwind && node esbuild.js --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "package": "npm run check-types && npm run lint && npm run build:tailwind && node esbuild.js --production && npm run validate-build",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "build:tailwind": "npx tailwindcss -i ./src/ui/css/tailwind.css -o ./out/css/output.css --minify",
    "validate-build": "node validate-build.js"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "coveralls": "^3.1.1",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "uuid": "^11.1.0"
  }
}