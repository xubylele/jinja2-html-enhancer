{
  "name": "jinja2-html-enhancer",
  "displayName": "Jinja2 Enhance",
  "description": "Syntax highlighting and variable checking for Jinja2 templates",
  "version": "1.17.2",
  "publisher": "Xubylele",
  "icon": "resources/logo.png",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "vscode": "^1.102.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xubylele/jinja2-html-enhancer.git"
  },
  "bugs": {
    "url": "https://github.com/xubylele/jinja2-html-enhancer/issues"
  },
  "homepage": "https://jinja2.xuby.cl/",
  "changelog": "https://github.com/xubylele/jinja2-html-enhancer/blob/main/CHANGELOG.md",
  "license": "MIT",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:jinja2"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "%extension.configuration.title%",
      "properties": {
        "jinja2-html-enhancer.customVariables": {
          "type": "object",
          "description": "%extension.configuration.customVariables.description%",
          "default": {},
          "scope": "resource"
        },
        "jinja2-html-enhancer.toggleVariableCheck": {
          "type": "boolean",
          "description": "%extension.configuration.toggleVariableCheck.description%",
          "default": true,
          "scope": "resource"
        },
        "jinja2-html-enhancer.contextProfiles": {
          "type": "object",
          "description": "%extension.configuration.contextProfiles.description%",
          "default": {},
          "scope": "resource"
        },
        "jinja2-html-enhancer.formatting.enabled": {
          "type": "boolean",
          "description": "%extension.configuration.formatting.enabled.description%",
          "default": true,
          "scope": "resource"
        },
        "jinja2-html-enhancer.formatting.formatOnSave": {
          "type": "boolean",
          "description": "%extension.configuration.formatting.formatOnSave.description%",
          "default": true,
          "scope": "resource"
        },
        "jinja2-html-enhancer.templateRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "%extension.configuration.templateRoots.description%",
          "default": [],
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "command": "extension.checkJinja2Variables",
        "title": "%checkVariables.title%"
      },
      {
        "command": "extension.openVariablePanel",
        "title": "%openVariables.title%"
      },
      {
        "command": "extension.saveVariable",
        "title": "%saveVariable.title%"
      },
      {
        "command": "extension.toggleVariableCheck",
        "title": "%toggleVariableCheck.title%"
      },
      {
        "command": "extension.changeTheme",
        "title": "%changeTheme.title%"
      },
      {
        "command": "extension.toggleJinja2Comment",
        "title": "%toggleJinja2Comment.title%"
      },
      {
        "command": "extension.openTemplatePreview",
        "title": "%openTemplatePreview.title%"
      },
      {
        "command": "extension.previewWithProfile",
        "title": "%previewWithProfile.title%"
      }
    ],
    "keybindings": [
      {
        "command": "extension.toggleJinja2Comment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && editorLangId == 'html'"
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".html"
        ],
        "aliases": [
          "HTML (Jinja2)"
        ]
      },
      {
        "id": "jinja2",
        "extensions": [
          ".jinja2",
          ".j2",
          ".jinja"
        ],
        "aliases": [
          "Jinja2"
        ]
      }
    ],
    "grammars": [
      {
        "scopeName": "text.html.jinja2",
        "path": "./syntaxes/jinja2.tmLanguage.json",
        "injectTo": [
          "text.html"
        ]
      },
      {
        "language": "jinja2",
        "scopeName": "text.jinja2",
        "path": "./syntaxes/jinja2-standalone.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/jinja2.json"
      },
      {
        "language": "jinja2",
        "path": "./snippets/jinja2.json"
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@changesets/cli": "^2.31.0",
    "@eslint-community/eslint-utils": "^4.9.1",
    "@eslint-community/regexpp": "^4.12.2",
    "@eslint/config-array": "^0.23.5",
    "@eslint/core": "^1.2.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/object-schema": "^3.0.5",
    "@eslint/plugin-kit": "^0.7.1",
    "@jest/globals": "^30.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tybys/wasm-util": "^0.10.1",
    "@types/glob": "^9.0.0",
    "@types/i18n": "^0.13.12",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "babel-jest": "^30.4.1",
    "downlevel-dts": "^0.11.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "i18n": "^0.15.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-specific-snapshot": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "vscode-test": "^1.6.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm check-types && pnpm lint && pnpm build:tailwind && node esbuild.js",
    "build": "pnpm format && pnpm build:tailwind && node esbuild.js --production",
    "watch": "pnpm build:tailwind && node esbuild.js --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "package": "pnpm check-types && pnpm lint && pnpm build:tailwind && node esbuild.js --production && pnpm validate-build",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --ci",
    "test:coverage": "jest --coverage --runInBand",
    "build:tailwind": "tailwindcss -i ./src/ui/css/tailwind.css -o ./out/css/output.css --minify",
    "validate-build": "node validate-build.js",
    "changeset": "changeset",
    "changeset:check": "node -e \"const f=require('fs').readdirSync('.changeset').filter(n=>n.endsWith('.md')&&n!=='README.md');if(!f.length){process.stderr.write('No changeset found. Run: pnpm changeset\\n');process.exit(1)}else{console.log('Changesets found:',f.join(', '))}\"",
    "version": "changeset version && pnpm install"
  },
  "vsce": {
    "dependencies": false
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@xubylele/jinja2-enhanced-shared": "file:/Users/xuby/devs/apps/jinja2/jinja2-html-shared/xubylele-jinja2-enhanced-shared-0.5.1.tgz",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.2.4",
    "uuid": "^14.0.0"
  }
}
