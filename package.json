{
  "name": "jinja2-html-enhancer",
  "displayName": "Jinja2 Enhance",
  "description": "Syntax highlighting and variable checking for Jinja2 templates",
  "version": "1.3.1",
  "publisher": "Xubylele",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xubylele/jinja2-html-enhancer.git"
  },
  "bugs": {
    "url": "https://github.com/xubylele/jinja2-html-enhancer/issues"
  },
  "homepage": "https://github.com/xubylele/jinja2-html-enhancer#readme",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "%extension.configuration.title%",
      "properties": {
        "jinja2-html-enhancer.customVariables": {
          "type": "object",
          "description": "%extension.configuration.customVariables.description%",
          "default": {},
          "scope": "resource"
        },
        "jinja2-html-enhancer.toggleVariableCheck": {
          "type": "boolean",
          "description": "%extension.configuration.toggleVariableCheck.description%",
          "default": false,
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "command": "extension.checkJinja2Variables",
        "title": "%checkVariables.title%"
      },
      {
        "command": "extension.openVariablePanel",
        "title": "%openVariables.title%"
      },
      {
        "command": "extension.saveVariable",
        "title": "%saveVariable.title%"
      },
      {
        "command": "extension.toggleVariableCheck",
        "title": "%toggleVariableCheck.title%"
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".html"
        ],
        "aliases": [
          "HTML (Jinja2)"
        ]
      }
    ],
    "grammars": [
      {
        "language": "html",
        "scopeName": "text.html.jinja2",
        "path": "./syntaxes/jinja2.tmLanguage.json",
        "injectTo": [
          "text.html"
        ]
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "glob": "^11.0.0",
    "globals": "^15.13.0",
    "i18n": "^0.15.1",
    "mocha": "^11.0.1",
    "parcel": "^2.13.3",
    "postcss": "^8.4.49",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vscode-test": "^1.6.1"
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@types/i18n": "^0.13.12"
  }
}