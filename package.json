{
  "name": "jinja2-html-enhancer",
  "displayName": "Jinja2 HTML Enhancer",
  "description": "Syntax highlighting and variable checking for Jinja2 templates",
  "version": "1.0.2",
  "publisher": "Xubylele",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xubylele/jinja2-html-enhancer.git"
  },
  "bugs": {
    "url": "https://github.com/xubylele/jinja2-html-enhancer/issues"
  },
  "homepage": "https://github.com/xubylele/jinja2-html-enhancer#readme",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.checkJinja2Variables",
        "title": "Check Jinja2 Variables"
      },
      {
        "command": "extension.openVariablePanel",
        "title": "Open Variable Panel"
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".html"
        ],
        "aliases": [
          "HTML (Jinja2)"
        ]
      }
    ],
    "grammars": [
      {
        "language": "html",
        "scopeName": "text.html.jinja2",
        "path": "./syntaxes/jinja2.tmLanguage.json",
        "injectTo": [
          "text.html"
        ]
      }
    ]
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "glob": "^11.0.0",
    "globals": "^15.13.0",
    "mocha": "^11.0.2",
    "parcel": "^2.13.2",
    "postcss": "^8.4.49",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vscode-test": "^1.6.1"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  }
}
